---
import { getEntry } from 'astro:content';
import Código from './Código.astro';
import type { Fragmento } from '../util/fragmento';
import { recolectarDependencias } from '../util/dependencias';

interface Props {
    ruta: string
}

const { ruta } = Astro.props;

const python = await getEntry("pythons", ruta);
if (!python) throw Error(`No se ha encontrado el script de Python ${ruta}`);

// Ficheros a escribir en el sistema virtual, con las dependencias transitivas incluidas
const dependencias: Record<string, string> = Object.fromEntries(
    await recolectarDependencias(
        python.data.dependencias,
        async id => {
            const entrada = await getEntry("pythons", id);
            return entrada && {
                dependencias: entrada.data.dependencias,
                entrada: [`${id}.py`, entrada.data.fuente] as const
            };
        },
        ruta
    )
);

const directorio = ruta.includes("/") ? ruta.slice(0, ruta.lastIndexOf("/")) : ".";

const fragmentos = [
    ...python.data.parámetros.flatMap((p): Fragmento[] => [
        { texto: `${p.nombre} = ` },
        {
            entrada: {
                nombre: p.nombre,
                tipo: p.tipo,
                valor: p.porDefecto
            }
        },
        { texto: "\n" }
    ]),
    ...(python.data.parámetros.length > 0 ? [{ texto: "\n" }] : []),
    { texto: python.data.código }
];
---

<el-python data-programa={python.data.código}
           data-directorio={directorio}
           data-dependencias={JSON.stringify(dependencias)}>
    <Código fragmentos={fragmentos} />
    {python.data.ejecutable && <button type="button" class="ejecutar">Ejecutar</button>}
    {python.data.ejecutable && <pre class="salida" hidden></pre>}
</el-python>

<script>
    import { obtenerPyodide, encolarTarea } from "../scripts/pyodide";
    import { crearEscritor } from "../scripts/salida";

    const ENTERO = /^-?\d+$/;

    class Python extends HTMLElement {

        connectedCallback() {
            const botón = this.querySelector<HTMLButtonElement>("button.ejecutar");
            const salida = this.querySelector<HTMLPreElement>("pre.salida");
            if (!botón || !salida) return; // fragmento no ejecutable

            const programa = this.dataset.programa;
            if (!programa) throw Error("El fragmento no tiene programa asociado");

            const directorio = this.dataset.directorio!;
            const dependencias: Record<string, string> = JSON.parse(this.dataset.dependencias || "{}");

            const entradas = [...this.querySelectorAll<HTMLInputElement>("input[data-parámetro]")];

            // Pyodide entrega las líneas sin el salto, así que se lo ponemos aquí.
            const { escribir: volcar, limpiar } = crearEscritor(salida);
            const escribir = (texto: string) => volcar(texto + "\n");

            const leerParámetros = (): Map<string, string | number> | null => {
                const valores = new Map<string, string | number>();

                for (const entrada of entradas) {
                    const nombre = entrada.dataset.parámetro;
                    if (!nombre) continue;

                    if (entrada.value.trim() === "") {
                        escribir(`Rellena «${nombre}».`);
                        return null;
                    }

                    if (entrada.dataset.tipo === "entero") {
                        if (!ENTERO.test(entrada.value.trim())) {
                            escribir(`«${nombre}» tiene que ser un número entero.`);
                            return null;
                        }
                        valores.set(nombre, Number(entrada.value));
                    } else {
                        valores.set(nombre, entrada.value);
                    }
                }

                return valores;
            };

            const ejecutar = async () => {
                botón.disabled = true;
                salida.hidden = false;
                limpiar();

                try {
                    const valores = leerParámetros();
                    if (!valores) return;

                    escribir("Cargando Python…");
                    const pyodide = await obtenerPyodide();
                    limpiar();

                    // Todo lo que toca el intérprete compartido va dentro de la cola, no
                    // solo la ejecución: `setStdout` es global y `sys.path` también.
                    await encolarTarea(async () => {
                        for (const [ruta, fuente] of Object.entries(dependencias)) {
                            pyodide.FS.mkdirTree(ruta.slice(0, ruta.lastIndexOf("/")));
                            pyodide.FS.writeFile(ruta, fuente, { encoding: "utf8" });
                        }
                        pyodide.runPython(
                            `import sys\n` +
                            `if ${JSON.stringify(directorio)} not in sys.path:\n` +
                            `    sys.path.insert(0, ${JSON.stringify(directorio)})`
                        );

                        // Espacio de nombres nuevo por ejecución: los fragmentos de una
                        // misma página comparten intérprete, pero no estado. `__name__`
                        // imita a `python fichero.py`.
                        const espacio = pyodide.toPy({ __name__: "__main__" });
                        pyodide.setStdout({ batched: escribir });
                        pyodide.setStderr({ batched: escribir });
                        try {
                            for (const [nombre, valor] of valores) espacio.set(nombre, valor);
                            await pyodide.runPythonAsync(programa, { globals: espacio });
                        } finally {
                            pyodide.setStdout({});
                            pyodide.setStderr({});
                            espacio.destroy();
                        }
                    });
                } catch (error) {
                    escribir(String(error instanceof Error ? error.message : error));
                } finally {
                    botón.disabled = false;
                }
            };

            botón.addEventListener("click", ejecutar);
        }
    }

    customElements.define('el-python', Python);
</script>
