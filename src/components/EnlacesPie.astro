---
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
    capítulo: CollectionEntry<"capítulos">
}

const { capítulo } = Astro.props;

const capítulos = (await getCollection("capítulos")).sort((a, b) => a.data.orden - b.data.orden);
const posición = capítulos.findIndex(c => c.id === capítulo.id);

const capítuloAnterior = posición > 0 ? capítulos[posición - 1] : undefined;
const capítuloSiguiente = capítulos[posición + 1];
---

<nav>
    <ul>
        { capítuloSiguiente && <li><a rel="next" href={`/${capítuloSiguiente.id}`}><span>Siguiente</span> {capítuloSiguiente.data.título}</a></li> }
        <li><a href="/">Volver al índice</a></li>
        { capítuloAnterior && <li><a rel="prev" href={`/${capítuloAnterior.id}`}><span>Anterior</span> {capítuloAnterior.data.título}</a></li> }
    </ul>
</nav>
