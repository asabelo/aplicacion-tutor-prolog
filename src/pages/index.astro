---
import { getCollection, type CollectionEntry } from "astro:content";
import DiseñoBásico from "../layouts/DiseñoBásico.astro"

const capítulos = (await getCollection("capítulos")).sort((a, b) => a.data.orden - b.data.orden);

const grupos: { nombre: string, capítulos: CollectionEntry<"capítulos">[] }[] = [];

for (const capítulo of capítulos) {
    const grupo = grupos.at(-1);

    if (grupo?.nombre === capítulo.data.grupoÍndice) {
        grupo.capítulos.push(capítulo);
    } else {
        grupos.push({ nombre: capítulo.data.grupoÍndice, capítulos: [capítulo] });
    }
}
---

<DiseñoBásico>

    <Fragment slot="head">
        <title>Prolog 27 mg</title>
        <meta name="description" content="Aplicación tutor interactiva para el aprendizaje de Prolog de forma amena e intuitiva.">
    </Fragment>

    <h1>Prolog 27 mg</h1>
    <nav aria-label="Tabla de contenidos">
        <ol>
            {grupos.map(grupo =>
                <li>
                    <h2 set:html={grupo.nombre} />
                    <ul>
                        {grupo.capítulos.map(capítulo =>
                            <li>
                                <a href={`/${capítulo.id}`} set:html={capítulo.data.títuloÍndice ?? capítulo.data.título} />
                            </li>
                        )}
                    </ul>
                </li>
            )}
        </ol>
    </nav>

</DiseñoBásico>
